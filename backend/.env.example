# ==============================================================================
# NGSkillForge Learning Platform - Backend Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development or enter these variables
# directly into your Render Web Service dashboard under the "Environment" tab.
# NEVER commit actual secrets or the '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
# Port for the Express server to listen on.
# On Render: Render automatically injects PORT (e.g. 10000). Leave default for local.
PORT=5000

# Environment mode: 'development' or 'production'.
# On Render Web Service: Set to 'production'.
NODE_ENV=production

# Comma-separated list of allowed frontend client URLs for CORS.
# For Render deployment, include the deployed Render Static Site domain:
# Example: https://ngskillforge-frontend.onrender.com,http://localhost:5173
FRONTEND_URLS=https://ngskillforge-frontend.onrender.com,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Full MongoDB Atlas connection string with database name included.
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/<dbname>?retryWrites=true&w=majority
# Source: MongoDB Atlas Dashboard -> Database -> Connect -> Drivers (Node.js)
# NOTE: Ensure you replace <password> with your DB user's password (URL-encoded if containing special chars)
# and verify Network Access in MongoDB Atlas allows IP '0.0.0.0/0' for Render.
MONGO_URI=mongodb+srv://db_user:db_password_here@cluster0.xxxxx.mongodb.net/NGSkillForge?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT access (15m) and refresh (7d) tokens.
# Generate a strong 64-byte random hex string: run `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Primary administrator email.
# Any user registering or logging in with this email automatically receives the 'admin' role.
PRIMARY_ADMIN_EMAIL=admin@example.com

# Rate limiting for auth endpoints (/api/auth)
# Time window in milliseconds (default: 900000 = 15 minutes)
AUTH_RATE_WINDOW_MS=900000
# Maximum allowed requests per IP within the time window (default: 100)
AUTH_RATE_LIMIT=100

# ------------------------------------------------------------------------------
# 4. Email & OTP Verification
# ------------------------------------------------------------------------------
# OPTION A (Recommended for Render): Resend HTTPS REST API (Port 443 - zero firewall blocks)
# Free 3,000 emails/month at https://resend.com -> API Keys
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=NGSkillForge <onboarding@resend.dev>

# OPTION B: Gmail SMTP (Nodemailer)
# Gmail address used to send 6-digit OTP verification codes during user registration.
EMAIL_USER=your_email@gmail.com

# Gmail 16-character App Password (NOT your personal Google account password).
# Source: Google Account -> Security -> 2-Step Verification -> App Passwords -> Generate for "Mail"
EMAIL_PASS=your_16_character_gmail_app_password

# ------------------------------------------------------------------------------
# 5. File Uploads (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary credentials for assignment submissions and document/media uploads.
# Source: Cloudinary Console Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. AI Features (Groq Cloud API)
# ------------------------------------------------------------------------------
# Groq API key for AI Tutor chat, AI lecture question-answering, and content generation.
# Source: Groq Cloud Console -> API Keys (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM model name (default in code fallback is 'qwen/qwen3.8-27b')
# Recommended fast educational models: 'qwen/qwen3.8-27b', 'llama-3.3-70b-versatile'
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 7. Optional Integrations
# ------------------------------------------------------------------------------
# Google YouTube Data API v3 key (optional).
# If omitted, YouTube lecture metadata & pagination automatically use the built-in web scraper.
# Source: Google Cloud Console -> APIs & Services -> Credentials
# YOUTUBE_API_KEY=your_google_youtube_data_api_v3_key
